# Environment Configuration for AI Cyber Threat Intelligence Platform

# Server Configuration
ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Database (PostgreSQL for Docker, SQLite fallback for quick local testing)
DATABASE_URL=postgresql://postgres:postgres@db:5432/cyber_threat_platform
# Local SQLite fallback:
# DATABASE_URL=sqlite:///./cyber_threat_platform.db

# Security & Secret Keys
SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production

# Detection Thresholds
LOGIN_FAILED_THRESHOLD=5
LOGIN_WINDOW_SECONDS=120
PORT_SCAN_PORT_THRESHOLD=10
PORT_SCAN_WINDOW_SECONDS=60
CORRELATION_WINDOW_SECONDS=1800
RISK_DECAY_HALF_LIFE_HOURS=24
